<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261109000000-1" author="fullstackapp">
        <createTable tableName="ebook">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_ebook"/>
            </column>
            <column name="format" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(255)"/>
            <column name="price" type="decimal(21,2)"/>
            <column name="file_object_key" type="varchar(255)"/>
        </createTable>
        <sql>
            ALTER TABLE ebook ADD CONSTRAINT ck_ebook_format CHECK (format IN ('PDF', 'WORD'));
            ALTER TABLE ebook ADD CONSTRAINT ck_ebook_quantity CHECK (quantity = 1);
        </sql>
    </changeSet>

    <changeSet id="20261109000000-2" author="fullstackapp">
        <createTable tableName="ebook_order">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_ebook_order"/>
            </column>
            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)"/>
            <column name="placed_at" type="${datetimeType}"/>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="ebook_order"
            baseColumnNames="user_id"
            constraintName="fk_ebook_order_user_id"
            referencedTableName="jhi_user"
            referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="20261109000000-3" author="fullstackapp">
        <createTable tableName="order_item">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_order_item"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="ebook_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="unit_price" type="decimal(21,2)"/>
        </createTable>
        <addUniqueConstraint
            tableName="order_item"
            columnNames="ebook_id"
            constraintName="ux_order_item_ebook_id"/>
        <addForeignKeyConstraint
            baseTableName="order_item"
            baseColumnNames="order_id"
            constraintName="fk_order_item_order_id"
            referencedTableName="ebook_order"
            referencedColumnNames="id"/>
        <addForeignKeyConstraint
            baseTableName="order_item"
            baseColumnNames="ebook_id"
            constraintName="fk_order_item_ebook_id"
            referencedTableName="ebook"
            referencedColumnNames="id"/>
        <sql>
            ALTER TABLE order_item ADD CONSTRAINT ck_order_item_quantity CHECK (quantity = 1);
        </sql>
    </changeSet>

